# gleis404 configuration — copy this file to `.env` and adjust values.
#
# Layering (highest wins):  CLI flags  >  this file  >  watchlist.toml
#                            >  built-in defaults.
# Real environment variables always override this file; comment a line
# out (or leave it blank) to fall back to the next layer. Invalid
# values are ignored with a warning — they can never break the tool.
# The stations to watch live in src/gleis404/watchlist.toml (TOML).

# Seconds between collection cycles (1 = every minute, 300 = every 5 min)
GLEIS404_INTERVAL_SECONDS=300

# Departures fetched per station per collection cycle
GLEIS404_RESULTS=20

# SQLite database location (relative to the working directory)
GLEIS404_DATABASE=data/gleis404.db

# Directory for the generated PNG figures
GLEIS404_PLOTS_DIR=plots

# How many lines the by-line table and chart show
GLEIS404_TOP=10

# Transitous API endpoint (http/https only) and identifying User-Agent:
# the Transitous usage policy asks for your contact details in the UA,
# so put your email or profile URL between the parentheses.
GLEIS404_API_BASE_URL=https://api.transitous.org
GLEIS404_USER_AGENT=gleis404/0.1.0 (https://github.com/OmranAlsahhar/Gleis_404)

# HTTP request timeout in seconds (positive number)
GLEIS404_TIMEOUT=15

# IANA timezone for hour-of-day and weekday analysis
GLEIS404_TIMEZONE=Europe/Berlin
